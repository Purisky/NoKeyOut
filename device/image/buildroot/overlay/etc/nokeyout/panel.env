# NoKeyOut panel 运行配置（镜像默认值；setup.sh 会写一份更全的）
PANEL_HOST=0.0.0.0
PANEL_PORT=8443
# 界面语言（zh|en）：屏幕与 Web 同源；用户在页面右上角切换后写到
# /var/lib/nokeyout/lang 覆盖本项
PANEL_LANG=zh
PANEL_TLS_CERT=/var/lib/nokeyout/tls/server.crt
PANEL_TLS_KEY=/var/lib/nokeyout/tls/server.key
PANEL_GATE=process
GATEWAY_BASE=http://127.0.0.1:3425
UPSTREAM_WEB=http://127.0.0.1:3430
# 屏幕（可选）：Go panel 内渲染线程，console|st7789；空=不渲染
# SCREEN_BACKEND=st7789
# SCREEN_SPI=/dev/spidev1.1
# SCREEN_DC=128        # GPIO4_A0
# SCREEN_RST=140       # GPIO4_B4；-1=不接硬件复位
# SCREEN_MADCTL=0x00
# SCREEN_XOFF=0
# SCREEN_YOFF=0
# SCREEN_INVERT=1
# SCREEN_SELFTEST=1
# 屏幕上电门（门文件存在前，屏幕保持熄闭：SPI 睡眠 + 背光熄灭）
# 放行：panel-go screen-gate pass；撤销：screen-gate revoke；查询：screen-gate status
SCREEN_GATE_FILE=/var/lib/nokeyout/state/screen.gate
# SCREEN_BL=-1         # 背光 GPIO 全局号（BLK 接线脚）；-1=不控背光
# 用户自定义屏页（JSON 描述符；损坏自动跳过，不影响内置三页）
SCREENS_DIR=/var/lib/nokeyout/screens
